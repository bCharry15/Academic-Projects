-- A=12 decimal, B=7 decimal. Desde reset: ACC 00 -> 0C -> 13.
-- Las demas instrucciones conservan el resultado de la suma.
WIDTH=11;
DEPTH=8;
ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;
CONTENT BEGIN
    0 : 30C;
    1 : 507;
    2 : 200;
    3 : 200;
    4 : 200;
    5 : 200;
    6 : 200;
    7 : 200;
END;
