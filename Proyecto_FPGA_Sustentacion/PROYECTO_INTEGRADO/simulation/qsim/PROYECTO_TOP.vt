module PROYECTO_TOP_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg CLOCK_50;
reg Reset;
reg SIM_MODE;
// wires                                               
wire [7:0] ACC;
wire Cout;
wire [6:0] HEX0;
wire [6:0] HEX1;
wire [2:0] PC;
wire PULSO;
wire [10:0] ROM_OUT;

wire sampler;                             

// assign statements (if any)                          
PROYECTO_TOP i1 (
// port map - connection between master ports and signals/registers   
	.ACC(ACC),
	.CLK(CLK),
	.CLOCK_50(CLOCK_50),
	.Cout(Cout),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.PC(PC),
	.PULSO(PULSO),
	.Reset(Reset),
	.ROM_OUT(ROM_OUT),
	.SIM_MODE(SIM_MODE)
);

// CLK
initial
begin
	CLK = 1'b1;
	CLK = #2000000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4500000 1'b1;
	CLK = #2500000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4000000 1'b1;
	CLK = #3000000 1'b0;
	CLK = #4000000 1'b1;
end 

// CLOCK_50
always
begin
	CLOCK_50 = 1'b0;
	CLOCK_50 = #10000 1'b1;
	#10000;
end 

// Reset
initial
begin
	Reset = 1'b0;
	Reset = #500000 1'b1;
end 

// SIM_MODE
initial
begin
	SIM_MODE = 1'b1;
end 

PROYECTO_TOP_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.CLOCK_50(CLOCK_50),
	.Reset(Reset),
	.SIM_MODE(SIM_MODE),
	.sampler_tx(sampler)
);

PROYECTO_TOP_vlg_check_tst tb_out(
	.ACC(ACC),
	.Cout(Cout),
	.HEX0(HEX0),
	.HEX1(HEX1),
	.PC(PC),
	.PULSO(PULSO),
	.ROM_OUT(ROM_OUT),
	.sampler_rx(sampler)
);
endmodule

