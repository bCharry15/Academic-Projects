`timescale 1 ps/ 1 ps
module PROYECTO_TOP_vlg_sample_tst(
	CLK,
	CLOCK_50,
	Reset,
	SIM_MODE,
	sampler_tx
);
input  CLK;
input  CLOCK_50;
input  Reset;
input  SIM_MODE;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or CLOCK_50 or Reset or SIM_MODE)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

